{
  "expo": {
    "name": "pokemongo",
    "slug": "pokemongo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pokemongo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pokémon GO ต้องการเข้าถึงตำแหน่งเพื่อค้นหาโปเกมอนป่ารอบตัวคุณ",
        "NSCameraUsageDescription": "Pokémon GO ต้องการเข้าถึงกล้องเพื่อเปิดโหมด AR ในการจับโปเกมอน"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pokémon GO ต้องการเข้าถึงตำแหน่งเพื่อค้นหาโปเกมอนป่ารอบตัวคุณ"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pokémon GO ต้องการเข้าถึงกล้องเพื่อเปิดโหมด AR ในการจับโปเกมอน"
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
