{
  "expo": {
    "name": "pokemongo",
    "slug": "pokemongo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pokemongo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pokémon GO ต้องการเข้าถึงตำแหน่งเพื่อค้นหาโปเกมอนป่ารอบตัวคุณ",
        "NSCameraUsageDescription": "Pokémon GO ต้องการเข้าถึงกล้องเพื่อเปิดโหมด AR ในการจับโปเกมอน"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "package": "com.anonymous.pokemongo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pokémon GO ต้องการเข้าถึงตำแหน่งเพื่อค้นหาโปเกมอนป่ารอบตัวคุณ"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pokémon GO ต้องการเข้าถึงกล้องเพื่อเปิดโหมด AR ในการจับโปเกมอน"
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
